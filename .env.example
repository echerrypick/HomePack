BRAVE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
EPC_BEARER_TOKEN=
CQC_API_KEY=
OFCOM_API_KEY=
# Use these when the Broadband and Mobile products have different subscription keys.
OFCOM_BROADBAND_API_KEY=
OFCOM_MOBILE_API_KEY=
NHS_API_KEY=
NHS_API_BASE_URL=https://int.api.service.nhs.uk/service-search-api
APP_URL=
# Set false only with a loopback APP_URL for local development. Hosted sites fail closed.
BILLING_ENABLED=true
# Payment setup: use test keys locally. APP_URL must be your trusted site origin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Firebase Admin: provide service account JSON securely or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Contact form delivery. For Gmail, SMTP_PASS must be a Google app password,
# not the normal account password. Keep these values server-side only.
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
